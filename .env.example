# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Feature Flags
FEATURE_SUBDOMAIN_REWRITE=false

# Cookie Domain (Fase 4: subdominios)
# Cuando FEATURE_SUBDOMAIN_REWRITE=true, las cookies de sesión deben compartirse
# entre dominio principal y subdominios. Setear con el punto adelante:
#   Producción: SHARED_COOKIE_DOMAIN=.store-lite.com
#   Desarrollo: SHARED_COOKIE_DOMAIN=.localhost
SHARED_COOKIE_DOMAIN=

# Database
DATABASE_URL=postgres://postgres:password@db.project.supabase.co:5432/postgres

# Factiliza
FACTILIZA_TOKEN=your-factiliza-token
FACTILIZA_WSP_INSTANCE=your-factiliza-whatsapp-instance

# Twilio WhatsApp OTP
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
OTP_HASH_SECRET=replace-with-a-strong-random-secret

# Sentry
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
