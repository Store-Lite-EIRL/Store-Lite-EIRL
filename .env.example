# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Customer Auth Popup
# Central domain where the auth popup runs (SAME app, different domain).
# In dev: http://localhost:3000
# In prod: https://your-production-domain.vercel.app
# All store domains open the popup to this URL — only ONE URL needs to be
# in Supabase's allowed Redirect URLs.
NEXT_PUBLIC_AUTH_ORIGIN=http://localhost:3000

# Feature Flags
FEATURE_SUBDOMAIN_REWRITE=false

# Cookie Domain (Fase 4: subdominios)
# Cuando FEATURE_SUBDOMAIN_REWRITE=true, las cookies de sesión deben compartirse
# entre dominio principal y subdominios. Setear con el punto adelante:
#   Producción: SHARED_COOKIE_DOMAIN=.store-lite.com
#   Desarrollo: SHARED_COOKIE_DOMAIN=.localhost
SHARED_COOKIE_DOMAIN=

# Database
DATABASE_URL=postgres://postgres:password@db.project.supabase.co:5432/postgres

# Culqi Key Enforcement
# Cuando CULQI_ENFORCE_LIVE_KEYS=true, la plataforma solo acepta llaves _live
# al configurar credenciales de pago. Útil en producción para evitar errores.
# En desarrollo dejarlo false o comentado.
CULQI_ENFORCE_LIVE_KEYS=false

# Factiliza
FACTILIZA_TOKEN=your-factiliza-token
FACTILIZA_WSP_INSTANCE=your-factiliza-whatsapp-instance

# Twilio WhatsApp OTP
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

OTP_HASH_SECRET=replace-with-a-strong-random-secret

# JSON.pe SMS — order notifications to customers
JSONPE_SMS_TOKEN=your-jsonpe-sms-token

# Resend — transactional emails (Server-side only)
RESEND_API_KEY=re_xxxxx
RESEND_FROM_EMAIL=notificaciones@tudominio.com

# SASS Notification Broadcast
# Used to authenticate system-level broadcasts (plan expiration, global announcements)
# Must match the key on the server. Generate a strong random key.
SASS_API_KEY=your-sass-api-key

# Sentry
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-project-token
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
